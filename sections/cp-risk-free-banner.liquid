<style>
  .cp-risk-free {
    position: relative;
    overflow: hidden;
    min-height: 500px;
    display: flex;
    align-items: center;
  }

  .cp-risk-free__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
  }

  .cp-risk-free::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 255, 255, 0.7) 40%,
      rgba(255, 255, 255, 0) 70%
    );
  }

  .cp-risk-free__inner {
    position: relative;
    z-index: 2;
    max-width: var(--page-width, 1200px);
    width: 100%;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .cp-risk-free__content {
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cp-risk-free__heading {
    font-size: 38px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    color: #1c1d1d;
    margin: 0;
    line-height: 1.25;
    letter-spacing: 0.3px;
  }

  .cp-risk-free__body {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 400;
    color: #4a4a4a;
    margin: 0;
    line-height: 1.65;
  }

  .cp-risk-free__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .cp-risk-free__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: {{ section.settings.button_bg | default: '#f0b43e' }};
    color: {{ section.settings.button_text | default: '#000000' }};
    text-decoration: none;
    padding: 12.5px 2.5rem;
    border-radius: 8px;
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
  }

  .cp-risk-free__button:hover {
    background: #000;
    color: #fff;
    box-shadow: 0px 0px 1px 1px #7c7c7c;
  }

  .cp-risk-free__guarantee {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 400;
    color: #666;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  @media screen and (max-width: 749px) {
    .cp-risk-free {
      min-height: 400px;
    }

    .cp-risk-free::after {
      background: linear-gradient(
        to top,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.8) 50%,
        rgba(255, 255, 255, 0.2) 100%
      );
    }

    .cp-risk-free__inner {
      padding: 3rem 1.5rem;
      display: flex;
      align-items: flex-end;
      min-height: 400px;
    }

    .cp-risk-free__heading {
      font-size: 28px;
    }

    .cp-risk-free__body {
      font-size: 14px;
    }

    .cp-risk-free__bg {
      object-position: center top;
    }
  }
</style>

<div class="cp-risk-free">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'cp-risk-free__bg', loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000' }}
  {%- endif -%}

  <div class="cp-risk-free__inner">
    <div class="cp-risk-free__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="cp-risk-free__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="cp-risk-free__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="cp-risk-free__cta">
          <a href="{{ section.settings.button_link | default: '#' }}" class="cp-risk-free__button">
            {{- section.settings.button_label | escape -}}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 10H16M11 5L16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          {%- if section.settings.guarantee_text != blank -%}
            <p class="cp-risk-free__guarantee">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M8 1L2 4V7.5C2 11.09 4.56 14.41 8 15.25C11.44 14.41 14 11.09 14 7.5V4L8 1Z" stroke="#666" stroke-width="1.2"/>
                <path d="M5.5 8L7.5 10L10.5 6.5" stroke="#666" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {{ section.settings.guarantee_text | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Risk-Free Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try It Now, 100% Risk Free"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Your Carepod Cube Plus is backed by our satisfaction guarantee, meaning you'll have 30 days to try it out for yourself to see why over 71,000+ homes love theirs."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Your Carepod Bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Try it 100% risk free"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#f0b43e"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Risk-Free Banner"
    }
  ]
}
{% endschema %}
