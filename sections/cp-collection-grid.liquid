<style>
  .cp-collectiongrid {
    padding: 3rem 2rem 5rem;
    background: #fff;
  }

  .cp-collectiongrid__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
  }

  .cp-collectiongrid__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cp-collectiongrid__heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.25;
    color: #000;
    margin: 0 0 0.5rem;
  }

  .cp-collectiongrid__description {
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.6;
    color: #555;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Grid */
  .cp-collectiongrid__grid {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  .cp-collectiongrid__grid--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .cp-collectiongrid__grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .cp-collectiongrid__grid--cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Product card */
  .cp-collectiongrid__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
    overflow: hidden;
    background: #fafafa;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .cp-collectiongrid__card:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }

  .cp-collectiongrid__card-image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f0f0f0;
  }

  .cp-collectiongrid__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .cp-collectiongrid__card:hover .cp-collectiongrid__card-img {
    transform: scale(1.05);
  }

  /* Badge for compare-at price */
  .cp-collectiongrid__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #c8102e;
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Card body */
  .cp-collectiongrid__card-body {
    padding: 1.25rem 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .cp-collectiongrid__card-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    color: #000;
    margin: 0;
  }

  /* Star rating */
  .cp-collectiongrid__rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cp-collectiongrid__stars {
    display: flex;
    gap: 2px;
    color: #f5a623;
    font-size: 14px;
    line-height: 1;
  }

  .cp-collectiongrid__stars svg {
    width: 14px;
    height: 14px;
    fill: #f5a623;
  }

  .cp-collectiongrid__stars svg.cp-collectiongrid__star--empty {
    fill: #ddd;
  }

  .cp-collectiongrid__rating-count {
    font-family: var(--font-body-family);
    font-size: 13px;
    color: #888;
  }

  /* Pricing */
  .cp-collectiongrid__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: auto;
  }

  .cp-collectiongrid__price-current {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 20px;
    color: #000;
  }

  .cp-collectiongrid__price-compare {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: #999;
    text-decoration: line-through;
  }

  /* Empty state */
  .cp-collectiongrid__empty {
    text-align: center;
    padding: 4rem 2rem;
    font-family: var(--font-body-family);
    font-size: 16px;
    color: #888;
  }

  /* Responsive: tablet */
  @media (max-width: 999px) {
    .cp-collectiongrid__grid--cols-4,
    .cp-collectiongrid__grid--cols-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Responsive: mobile */
  @media (max-width: 749px) {
    .cp-collectiongrid {
      padding: 2rem 1.25rem 3rem;
    }

    .cp-collectiongrid__heading {
      font-size: 28px;
    }

    .cp-collectiongrid__grid--cols-4,
    .cp-collectiongrid__grid--cols-3,
    .cp-collectiongrid__grid--cols-2 {
      grid-template-columns: 1fr;
    }

    .cp-collectiongrid__card-title {
      font-size: 16px;
    }

    .cp-collectiongrid__price-current {
      font-size: 18px;
    }
  }
</style>

<div class="cp-collectiongrid">
  <div class="cp-collectiongrid__inner">
    {%- if section.settings.heading != blank -%}
      <div class="cp-collectiongrid__header">
        <h2 class="cp-collectiongrid__heading">{{ section.settings.heading }}</h2>
        {%- if collection.description != blank and section.settings.show_description -%}
          <p class="cp-collectiongrid__description">{{ collection.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="cp-collectiongrid__grid cp-collectiongrid__grid--cols-{{ section.settings.products_per_row }}">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="cp-collectiongrid__card">
            <div class="cp-collectiongrid__card-image-wrap">
              {%- if product.featured_image != blank -%}
                <img
                  class="cp-collectiongrid__card-img"
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'cp-collectiongrid__card-img' }}
              {%- endif -%}

              {%- if product.compare_at_price > product.price -%}
                <span class="cp-collectiongrid__badge">Sale</span>
              {%- endif -%}
            </div>

            <div class="cp-collectiongrid__card-body">
              <h3 class="cp-collectiongrid__card-title">{{ product.title }}</h3>

              {%- if section.settings.show_rating and product.metafields.reviews.rating.value != blank -%}
                {%- assign rating_value = product.metafields.reviews.rating.value.rating | round: 1 -%}
                {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
                <div class="cp-collectiongrid__rating">
                  <div class="cp-collectiongrid__stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= rating_value -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- else -%}
                        <svg class="cp-collectiongrid__star--empty" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if rating_count != blank -%}
                    <span class="cp-collectiongrid__rating-count">({{ rating_count }})</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="cp-collectiongrid__price">
                <span class="cp-collectiongrid__price-current">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="cp-collectiongrid__price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="cp-collectiongrid__empty">No products found in this collection.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CP Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true,
      "info": "Uses product review metafields"
    }
  ],
  "presets": [
    {
      "name": "CP Collection Grid"
    }
  ],
  "templates": ["collection"]
}
{% endschema %}
