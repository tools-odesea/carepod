{% style %}
  .cp-fgrid {
    background-color: {{ section.settings.bg_color }};
    padding: 100px 16px;
  }

  .cp-fgrid__inner {
    max-width: 928px;
    margin: 0 auto;
  }

  .cp-fgrid__heading {
    font-family: var(--font-heading-family);
    font-size: 56px;
    font-weight: 600;
    letter-spacing: -1.12px;
    color: #2f2f2f;
    text-align: center;
    margin: 0 0 16px;
  }

  .cp-fgrid__subheading {
    font-family: var(--font-body-family);
    font-size: 16px;
    color: #46474c;
    text-align: center;
    margin: 0 0 48px;
  }

  .cp-fgrid__image {
    width: 100%;
    display: block;
    border-radius: 8px;
    margin-bottom: 64px;
  }

  .cp-fgrid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px 40px;
  }

  .cp-fgrid__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cp-fgrid__icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }

  .cp-fgrid__title {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 600;
    color: #2f2f2f;
    margin: 0;
  }

  .cp-fgrid__desc {
    font-family: var(--font-body-family);
    font-size: 16px;
    color: #46474c;
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .cp-fgrid {
      padding: 64px 16px;
    }

    .cp-fgrid__heading {
      font-size: 36px;
      letter-spacing: -0.72px;
    }

    .cp-fgrid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 16px;
    }

    .cp-fgrid__image {
      margin-bottom: 40px;
    }
  }
{% endstyle %}

<section class="cp-fgrid">
  <div class="cp-fgrid__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="cp-fgrid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="cp-fgrid__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- liquid
      assign section_image = section.settings.image
      assign section_image_url = section.settings.image_url
    -%}

    {%- if section_image != blank -%}
      <img
        class="cp-fgrid__image"
        src="{{ section_image | image_url: width: 1856 }}"
        alt="{{ section_image.alt | escape }}"
        width="{{ section_image.width }}"
        height="{{ section_image.height }}"
        loading="lazy"
      >
    {%- elsif section_image_url != blank -%}
      <img
        class="cp-fgrid__image"
        src="{{ section_image_url }}"
        alt=""
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="cp-fgrid__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            {%- liquid
              assign icon_image = block.settings.icon
              assign icon_url = block.settings.icon_url
            -%}
            <div class="cp-fgrid__item" {{ block.shopify_attributes }}>

              {%- if icon_image != blank -%}
                <img
                  class="cp-fgrid__icon"
                  src="{{ icon_image | image_url: width: 64 }}"
                  alt="{{ icon_image.alt | escape }}"
                  width="32"
                  height="32"
                  loading="lazy"
                >
              {%- elsif icon_url != blank -%}
                <img
                  class="cp-fgrid__icon"
                  src="{{ icon_url }}"
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                >
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <p class="cp-fgrid__title">{{ block.settings.title }}</p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="cp-fgrid__desc">{{ block.settings.description }}</p>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "CP Features Grid",
  "tag": "section",
  "class": "cp-features-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built different. By design."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every detail of Carepod was engineered with your health in mind."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Product image URL (fallback)",
      "info": "Used if no image is selected above."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_url",
          "label": "Icon URL (fallback)",
          "info": "Used if no icon image is selected above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CP Features Grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Invented by a Doctor",
            "description": "The first humidifier designed to be truly hygienic, for better, safer air."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "99.9% Sterilizable",
            "description": "Pop into the dishwasher or boil stainless steel parts for 99.9% sterilization."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Easy to Clean",
            "description": "Made with only three parts, and a top-fill water tank. No hidden nooks for dangerous mold."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Patented Technology",
            "description": "Ultrasonic oscillator wand technology, invented to gently hydrate rooms."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "No Monthly Subscriptions",
            "description": "Skip the hassle of filter replacements. Perfect for long-term cost savings."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Filter-Free",
            "description": "Ditch dangerous breeding grounds for mold, germs and bacteria."
          }
        }
      ]
    }
  ]
}
{% endschema %}
