<style>
  .cp-benefits {
    background: {{ section.settings.bg_color }};
    padding: 4rem 2rem;
  }

  .cp-benefits__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
  }

  .cp-benefits__heading {
    font-size: 35px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.4px;
  }

  .cp-benefits__grid {
    display: flex;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    flex-wrap: wrap;
  }

  .cp-benefits__item {
    flex: 1;
    min-width: 160px;
    max-width: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .cp-benefits__icon {
    width: 85px;
    height: 85px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cp-benefits__icon svg {
    width: 40px;
    height: 40px;
    stroke: {{ section.settings.text_color }};
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cp-benefits__icon img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .cp-benefits__title {
    font-family: var(--font-heading-family);
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .cp-benefits__desc {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
    margin: 0;
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .cp-benefits {
      padding: 3rem 1.5rem;
    }

    .cp-benefits__heading {
      font-size: 24px;
    }

    .cp-benefits__grid {
      gap: 1.5rem;
    }

    .cp-benefits__item {
      min-width: 130px;
      max-width: 160px;
    }

    .cp-benefits__icon {
      width: 70px;
      height: 70px;
    }

    .cp-benefits__icon svg {
      width: 32px;
      height: 32px;
    }
  }
</style>

<div class="cp-benefits">
  <div class="cp-benefits__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cp-benefits__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="cp-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="cp-benefits__item" {{ block.shopify_attributes }}>
          <div class="cp-benefits__icon">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif block.settings.icon == 'doctor' -%}
              <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 4C13.4 4 8 9.4 8 16v4a2 2 0 0 0 2 2h1v-6a9 9 0 1 1 18 0v6h1a2 2 0 0 0 2-2v-4c0-6.6-5.4-12-12-12z"/>
                <circle cx="20" cy="28" r="5"/>
                <path d="M20 33c-5 0-9 2.5-9 5v1h18v-1c0-2.5-4-5-9-5z"/>
              </svg>
            {%- elsif block.settings.icon == 'sterilize' -%}
              <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="14"/>
                <path d="M14 20l4 4 8-8"/>
              </svg>
            {%- elsif block.settings.icon == 'steel' -%}
              <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 8h16v4H12z"/>
                <path d="M14 12v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V12"/>
                <path d="M20 16v10"/>
                <path d="M16 20h8"/>
              </svg>
            {%- elsif block.settings.icon == 'germ-free' -%}
              <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6v4M20 30v4M6 20h4M30 20h4M10.1 10.1l2.8 2.8M27.1 27.1l2.8 2.8M29.9 10.1l-2.8 2.8M12.9 27.1l-2.8 2.8"/>
                <circle cx="20" cy="20" r="7"/>
                <path d="M17 20l2 2 4-4"/>
              </svg>
            {%- elsif block.settings.icon == 'no-subscription' -%}
              <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <rect x="8" y="10" width="24" height="20" rx="2"/>
                <path d="M8 16h24"/>
                <path d="M14 22h6"/>
                <path d="M14 26h4"/>
                <line x1="8" y1="10" x2="32" y2="30" stroke-width="2"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="14"/>
                <path d="M14 20l4 4 8-8"/>
              </svg>
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <p class="cp-benefits__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="cp-benefits__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Benefits",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Humidifier, Reinvented."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "doctor", "label": "Doctor Designed" },
            { "value": "sterilize", "label": "99.9% Sterilizable" },
            { "value": "steel", "label": "Stainless Steel" },
            { "value": "germ-free", "label": "Germ-Free" },
            { "value": "no-subscription", "label": "No Subscriptions" }
          ],
          "default": "doctor"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Overrides the icon selector above if set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Doctor Designed"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Simple, sleek, award-winning. With just three parts to clean."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "doctor", "title": "Doctor Designed", "description": "Simple, sleek, award-winning. With just three parts to clean." } },
        { "type": "benefit", "settings": { "icon": "sterilize", "title": "99.9% Sterilizable", "description": "Easy to boil to eliminate mold + bacteria." } },
        { "type": "benefit", "settings": { "icon": "steel", "title": "Stainless Steel", "description": "Dishwasher-safe water tank with a top-fill design." } },
        { "type": "benefit", "settings": { "icon": "germ-free", "title": "Safe and Germ-Free", "description": "No hidden nooks or crannies that breed bacteria." } },
        { "type": "benefit", "settings": { "icon": "no-subscription", "title": "No Monthly Subscriptions", "description": "Skip the hassle of filter replacements. Perfect for long-term cost savings." } }
      ]
    }
  ]
}
{% endschema %}
