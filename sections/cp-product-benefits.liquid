<style>
  .cp-benefits {
    background: {{ section.settings.bg_color }};
    padding: 4rem 2rem;
  }

  .cp-benefits__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
  }

  .cp-benefits__heading {
    font-size: 35px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.4px;
  }

  .cp-benefits__grid {
    display: flex;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    flex-wrap: wrap;
  }

  .cp-benefits__item {
    flex: 1;
    min-width: 160px;
    max-width: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .cp-benefits__icon {
    width: 85px;
    height: 85px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cp-benefits__icon svg {
    width: 85px;
    height: 85px;
  }

  .cp-benefits__icon img {
    width: 85px;
    height: 85px;
    object-fit: contain;
  }

  .cp-benefits__title {
    font-family: var(--font-heading-family);
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .cp-benefits__desc {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
    margin: 0;
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .cp-benefits {
      padding: 3rem 1.5rem;
    }

    .cp-benefits__heading {
      font-size: 24px;
    }

    .cp-benefits__grid {
      gap: 1.5rem;
    }

    .cp-benefits__item {
      min-width: 130px;
      max-width: 160px;
    }

    .cp-benefits__icon {
      width: 70px;
      height: 70px;
    }

    .cp-benefits__icon svg {
      width: 70px;
      height: 70px;
    }
  }
</style>

<div class="cp-benefits">
  <div class="cp-benefits__inner">
