                    <rect transform="translate(0 0.240234)" fill="white" height="85" width="85"/>
                  </clipPath>
                </defs>
              </svg>
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" width="86" height="85" viewBox="0 0 86 85" fill="none">
                <path d="M43 85C66.4721 85 85.5 65.9721 85.5 42.5C85.5 19.0279 66.4721 0 43 0C19.5279 0 0.5 19.0279 0.5 42.5C0.5 65.9721 19.5279 85 43 85Z" fill="#E4E4E4"/>
                <path d="M30 42.5L39 51.5L56 34.5" stroke="#0F1112" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <p class="cp-benefits__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="cp-benefits__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

