<style>
  .cp-image-text {
    padding: 4rem 2rem;
    background: {{ section.settings.bg_color }};
  }

  .cp-image-text__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .cp-image-text__inner--reversed {
    direction: rtl;
  }

  .cp-image-text__inner--reversed > * {
    direction: ltr;
  }

  .cp-image-text__image {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .cp-image-text__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cp-image-text__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cp-image-text__eyebrow {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #888;
    margin: 0;
  }

  .cp-image-text__heading {
    font-family: var(--font-heading-family);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
    color: #1c1d1d;
    margin: 0;
  }

  .cp-image-text__body {
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    margin: 0;
  }

  .cp-image-text__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #1c1d1d;
    color: #fff;
    text-decoration: none;
    padding: 12px 30px;
    border-radius: 6px;
    font-family: var(--font-body-family);
    font-size: 15px;
    font-weight: 600;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .cp-image-text__btn:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .cp-image-text {
      padding: 3rem 1.25rem;
    }

    .cp-image-text__inner,
    .cp-image-text__inner--reversed {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      direction: ltr;
    }

    .cp-image-text__heading {
      font-size: 26px;
    }
  }
</style>

<div class="cp-image-text">
  <div class="cp-image-text__inner{% if section.settings.image_position == 'right' %} cp-image-text__inner--reversed{% endif %}">
    <div class="cp-image-text__image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200' }}
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="cp-image-text__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cp-image-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cp-image-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="cp-image-text__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="cp-image-text__btn" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (fallback)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
