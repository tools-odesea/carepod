<style>
  .cp-feature-cards {
    background: {{ section.settings.bg_color }};
    padding: 4rem 2rem;
  }

  .cp-feature-cards__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .cp-feature-cards__heading {
    font-size: 38px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 600;
    color: #1c1d1d;
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.4px;
    text-align: center;
  }

  .cp-feature-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .cp-feature-card {
    background: #ffffff;
    border-radius: 17px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .cp-feature-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
  }

  .cp-feature-card__icon svg {
    width: 36px;
    height: 36px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cp-feature-card__icon img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .cp-feature-card__label {
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    color: #1c1d1d;
    margin: 0;
    line-height: 1.4;
  }

  .cp-feature-card__image {
    width: 100%;
    height: 460px;
    object-fit: cover;
    border-radius: 23px;
  }

  .cp-feature-card__title {
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 700;
    color: #1c1d1d;
    margin: 0;
    line-height: 1.35;
  }

  .cp-feature-card__desc {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 400;
    color: #4a4a4a;
    margin: 0;
    line-height: 158%;
    max-width: 70%;
  }

  .cp-feature-card__note {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 400;
    font-style: italic;
    color: #999;
    margin: 0;
    line-height: 1.5;
    max-width: 260px;
  }

  .cp-feature-cards__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .cp-feature-cards__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 8px;
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.3px;
    transition: background 0.2s ease;
  }

  .cp-feature-cards__button:hover {
    background: #333;
  }

  .cp-feature-cards__guarantee {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 400;
    color: #666;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  @media screen and (max-width: 749px) {
    .cp-feature-cards {
      padding: 3rem 1.5rem;
    }

    .cp-feature-cards__heading {
      font-size: 24px;
    }

    .cp-feature-cards__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .cp-feature-card__image {
      height: 300px;
    }

    .cp-feature-card__desc {
      max-width: 100%;
    }
  }
</style>

<div class="cp-feature-cards">
  <div class="cp-feature-cards__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cp-feature-cards__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="cp-feature-cards__grid">
      {%- for block in section.blocks -%}
        <div class="cp-feature-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank -%}
            <div class="cp-feature-card__icon">
              {{ block.settings.icon_image | image_url: width: 72 | image_tag: loading: 'lazy', alt: block.settings.label }}
            </div>
          {%- elsif block.settings.label != blank -%}
            <div class="cp-feature-card__icon">
              {%- if block.settings.icon == 'sanitize' -%}
                <svg viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 3v6M18 27v6M3 18h6M27 18h6"/>
                  <circle cx="18" cy="18" r="8"/>
                  <path d="M14 18l3 3 5-5"/>
                </svg>
              {%- elsif block.settings.icon == 'night' -%}
                <svg viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 19.5A11 11 0 0 1 16.5 8a11.06 11.06 0 0 0 0 22A11 11 0 0 0 28 19.5z"/>
                  <path d="M24 6l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/>
                </svg>
              {%- elsif block.settings.icon == 'humidity' -%}
                <svg viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 4s-9 10-9 17a9 9 0 1 0 18 0c0-7-9-17-9-17z"/>
                  <path d="M14 24a4 4 0 0 0 4 4"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="18" cy="18" r="12"/>
                  <path d="M13 18l3 3 7-7"/>
                </svg>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            <p class="cp-feature-card__label">{{ block.settings.label | escape }}</p>
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: class: 'cp-feature-card__image', loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '375, 550, 750, 800' }}
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="cp-feature-card__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="cp-feature-card__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}

          {%- if block.settings.footnote != blank -%}
            <p class="cp-feature-card__note">{{ block.settings.footnote | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="cp-feature-cards__footer">
        <a href="{{ section.settings.button_link | default: '#' }}" class="cp-feature-cards__button">
          {{- section.settings.button_label | escape -}}
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 10H16M11 5L16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        {%- if section.settings.guarantee_text != blank -%}
          <p class="cp-feature-cards__guarantee">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 1L2 4V7.5C2 11.09 4.56 14.41 8 15.25C11.44 14.41 14 11.09 14 7.5V4L8 1Z" stroke="#666" stroke-width="1.2"/>
              <path d="M5.5 8L7.5 10L10.5 6.5" stroke="#666" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.guarantee_text | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature Cards",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Cube, Upgraded"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Your Carepod Bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Try it 100% risk free"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAFAFA"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sanitize", "label": "Sanitize" },
            { "value": "night", "label": "Night mode" },
            { "value": "humidity", "label": "Humidity" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "sanitize"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Overrides the icon selector if set."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Feature label",
          "default": "One-Touch Sanitization"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Blissfully clean air."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Capable of killing bacteria* within a 2-hour cycle, for peace of mind in-between deep cleanings."
        },
        {
          "type": "textarea",
          "id": "footnote",
          "label": "Footnote (small text)",
          "info": "Optional disclaimer text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Cards",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "sanitize",
            "label": "One-Touch Sanitization",
            "title": "Blissfully clean air.",
            "description": "Capable of killing bacteria* within a 2-hour cycle, for peace of mind in-between deep cleanings.",
            "footnote": "*Kills 99.9% of harmful bacteria such as Pseudomonas aeruginosa, E. coli, Staphylococcus aureus, Pneumococcus, and Listeria bacteria with our patented pasteurization method"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "night",
            "label": "Night Mode",
            "title": "Restful, hydrated sleep.",
            "description": "Time to relax with display lights off at bedtime. Perfect for the most light-sensitive sleeper."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "humidity",
            "label": "Auto-Humidity",
            "title": "Optimal comfort.",
            "description": "Set it and forget it, with a smart feature that adapts to your room's humidity levels for perfect hydration."
          }
        }
      ]
    }
  ]
}
{% endschema %}
