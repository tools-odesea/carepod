<style>
  .cp-faq {
    background: {{ section.settings.bg_color }};
    padding: 4rem 2rem;
  }

  .cp-faq__inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cp-faq__heading {
    font-size: 35px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    color: #1c1d1d;
    margin: 0 0 1rem;
    line-height: 1.3;
    letter-spacing: 0.4px;
    text-align: center;
  }

  .cp-faq__item {
    border-bottom: 1px solid rgba(140, 140, 140, 0.13);
    padding: 5px 0;
  }

  .cp-faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 16px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-weight: 600;
    color: #1c1d1d;
    line-height: 1.4;
  }

  .cp-faq__question:hover {
    color: #555;
  }

  .cp-faq__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    transition: transform 0.25s ease;
  }

  .cp-faq__item.is-open .cp-faq__icon {
    transform: rotate(180deg);
  }

  .cp-faq__answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0 0;
  }

  .cp-faq__item.is-open .cp-faq__answer {
    max-height: 500px;
    padding: 0 0 1.25rem;
  }

  .cp-faq__answer-text {
    font-family: var(--font-body-family);
    font-size: 15px;
    font-weight: 400;
    color: #4a4a4a;
    margin: 0;
    line-height: 1.7;
  }

  @media screen and (max-width: 749px) {
    .cp-faq {
      padding: 3rem 1.5rem;
    }

    .cp-faq__heading {
      font-size: 24px;
    }

    .cp-faq__question {
      font-size: 15px;
      padding: 1rem 0;
    }

    .cp-faq__answer-text {
      font-size: 14px;
    }
  }
</style>

<div class="cp-faq" id="cp-faq-{{ section.id }}">
  <div class="cp-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cp-faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="cp-faq__item{% if block.settings.open_default %} is-open{% endif %}" {{ block.shopify_attributes }}>
        <button type="button" class="cp-faq__question" aria-expanded="{{ block.settings.open_default }}">
          <span>{{ block.settings.question | escape }}</span>
          <svg class="cp-faq__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="cp-faq__answer">
          <div class="cp-faq__answer-text">{{ block.settings.answer }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function() {
    const faq = document.getElementById('cp-faq-{{ section.id }}');
    if (!faq) return;

    faq.addEventListener('click', function(e) {
      const btn = e.target.closest('.cp-faq__question');
      if (!btn) return;

      const item = btn.closest('.cp-faq__item');
      const wasOpen = item.classList.contains('is-open');

      item.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', !wasOpen);
    });
  })();
</script>

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Be Wondering..."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What Is The Difference Between The Carepod Cube & Carepod Cube Plus?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>The Carepod Cube Plus is the latest iteration of our high-end humidifier. It includes quality-of-life improvements such as built-in heat sanitization, auto-humidity controls, and night mode.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What Is The Difference Between The Carepod Cube & Carepod Cube Plus?",
            "answer": "<p>The Carepod Cube Plus is the latest iteration of our high-end humidifier. It includes quality-of-life improvements such as built-in heat sanitization, auto-humidity controls, and night mode.</p>",
            "open_default": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does The Carepod Cube Plus Clean Itself?",
            "answer": "<p>The Cube Plus features a built-in sanitization cycle that heats water to 158°F, killing 99.9% of bacteria. While this significantly reduces the need for manual cleaning, we still recommend a full clean every 1-2 weeks for optimal performance.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How About Shipping?",
            "answer": "<p>We offer free shipping on all orders within the United States. Orders are typically processed within 1-2 business days and delivered within 3-5 business days.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What Is Your Warranty?",
            "answer": "<p>Every Carepod comes with a 1-year manufacturer's warranty that covers defects in materials and workmanship under normal use.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How Do I Clean My Carepod?",
            "answer": "<p>Simply disassemble the three stainless steel components, wash with soap and water or place in the dishwasher, and for a deeper clean, boil the components for 1-2 minutes. Reassemble and you're good to go!</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
