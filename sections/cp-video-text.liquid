<style>
  .cp-video-text {
    background: {{ section.settings.bg_color }};
    padding: 4rem 2rem;
  }

  .cp-video-text__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .cp-video-text__media {
    flex: 1;
    min-width: 0;
  }

  .cp-video-text__video-wrap {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .cp-video-text__video {
    width: 100%;
    display: block;
    border-radius: 12px;
  }

  .cp-video-text__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    object-fit: cover;
  }

  .cp-video-text__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 3rem 0;
  }

  .cp-video-text__heading {
    font-size: 35px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 600;
    color: #1c1d1d;
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.4px;
  }

  .cp-video-text__subtitle {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 600;
    color: #1c1d1d;
    margin: 0;
    line-height: 1.5;
  }

  .cp-video-text__body {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 400;
    color: #4a4a4a;
    margin: 0;
    line-height: 1.6;
    letter-spacing: 0.3px;
  }

  .cp-video-text__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .cp-video-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #000000;
    color: #ffffff;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 8px;
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.3px;
    transition: background 0.2s ease;
  }

  .cp-video-text__button:hover {
    background: #333;
  }

  .cp-video-text__guarantee {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 400;
    color: #666;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Inverted layout */
  .cp-video-text--inverted .cp-video-text__inner {
    flex-direction: row-reverse;
  }

  @media screen and (max-width: 749px) {
    .cp-video-text {
      padding: 3rem 1.5rem;
    }

    .cp-video-text__inner {
      flex-direction: column;
      gap: 2rem;
    }

    .cp-video-text--inverted .cp-video-text__inner {
      flex-direction: column;
    }

    .cp-video-text__heading {
      font-size: 26px;
    }

    .cp-video-text__subtitle {
      font-size: 16px;
    }

    .cp-video-text__body {
      font-size: 14px;
    }
  }
</style>

<div class="cp-video-text{% if section.settings.invert_layout %} cp-video-text--inverted{% endif %}">
  <div class="cp-video-text__inner">
    <div class="cp-video-text__media">
      {%- if section.settings.video != blank -%}
        <div class="cp-video-text__video-wrap">
          {{ section.settings.video | video_tag: class: 'cp-video-text__video', controls: true, muted: false, preload: 'metadata' }}
        </div>
      {%- elsif section.settings.video_url != blank -%}
        <div class="cp-video-text__video-wrap">
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0"
              class="cp-video-text__video"
              style="aspect-ratio: 16/9; border: none;"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
              class="cp-video-text__video"
              style="aspect-ratio: 16/9; border: none;"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- endif -%}
        </div>
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'cp-video-text__image', loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '375, 550, 750, 1000, 1200' }}
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" class="cp-video-text__image" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>

    <div class="cp-video-text__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="cp-video-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="cp-video-text__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="cp-video-text__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="cp-video-text__cta">
          <a href="{{ section.settings.button_link | default: '#' }}" class="cp-video-text__button">
            {{- section.settings.button_label | escape -}}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 10H16M11 5L16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          {%- if section.settings.guarantee_text != blank -%}
            <p class="cp-video-text__guarantee">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M8 1L2 4V7.5C2 11.09 4.56 14.41 8 15.25C11.44 14.41 14 11.09 14 7.5V4L8 1Z" stroke="#666" stroke-width="1.2"/>
                <path d="M5.5 8L7.5 10L10.5 6.5" stroke="#666" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {{ section.settings.guarantee_text | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video + Text",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"],
      "info": "Used if no Shopify video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Shown if no video is set."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Fallback image URL",
      "info": "External URL used if no image is uploaded."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Say Hello To Carepod Cube Plus."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Refreshingly simple, powerfully effective."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Take a peek underneath the sleek, minimalist exterior and discover how Carepod makes healthy living easier than ever."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Your Carepod Bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Try it 100% risk free"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "invert_layout",
      "label": "Invert layout (text left, media right)",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Video + Text"
    }
  ]
}
{% endschema %}
