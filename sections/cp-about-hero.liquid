{{ 'cp-custom.css' | asset_url | stylesheet_tag }}

<style>
  .cp-abouthero {
    padding: 60px 0;
  }

  .cp-abouthero__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 40% 1fr;
    gap: 60px;
    align-items: center;
  }

  .cp-abouthero__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }

  .cp-abouthero__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cp-abouthero__placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cp-abouthero__placeholder svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .cp-abouthero__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cp-abouthero__heading {
    font-family: var(--font-heading-family);
    font-size: 42px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-foreground, #1a1a1a);
  }

  .cp-abouthero__text {
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-foreground, #444);
    margin: 0;
  }

  .cp-abouthero__text p {
    margin: 0 0 1em;
  }

  .cp-abouthero__text p:last-child {
    margin-bottom: 0;
  }

  .cp-abouthero__button {
    display: inline-block;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 36px;
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
    text-decoration: none;
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: opacity 0.25s ease;
    align-self: flex-start;
  }

  .cp-abouthero__button:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .cp-abouthero {
      padding: 40px 0;
    }

    .cp-abouthero__container {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 20px;
    }

    .cp-abouthero__heading {
      font-size: 28px;
    }

    .cp-abouthero__text {
      font-size: 15px;
    }
  }
</style>

<section class="cp-abouthero">
  <div class="cp-abouthero__container">
    <div class="cp-abouthero__image-wrapper">
      {%- if section.settings.founder_image != blank -%}
        {{ section.settings.founder_image | image_url: width: 800 | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800',
          sizes: '(max-width: 749px) 100vw, 40vw',
          alt: section.settings.heading
        }}
      {%- else -%}
        <div class="cp-abouthero__placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    </div>

    <div class="cp-abouthero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="cp-abouthero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body_text != blank -%}
        <div class="cp-abouthero__text">
          {{ section.settings.body_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="cp-abouthero__button"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CP About Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered By A Doctor, With The Heart Of A Father."
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Dr. Hyung Joo Kim created the Carepod to help his own family combat dry air. After years of frustration with humidifiers that were difficult to clean and prone to growing mold, he set out to create the world's cleanest humidifier. Now, his goal is to ensure that everyone can enjoy the safety and comfort of fresh, clean air.</p><p>To continually improve your health, we believe clean air matters as much as what you eat and drink. That's why we created Carepod — the cleanest humidifier on the planet, built without compromise.</p>"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "CP About Hero"
    }
  ]
}
{% endschema %}
