    "testimonials": {
      "type": "cp-testimonials",
      "blocks": {
        "t1": { "type": "testimonial", "settings": { "avatar_url": "https://hellocarepod.com/cdn/shop/files/Testimonials_Tim-Tiutan.jpg?v=1733175846&width=240", "quote": "I finally found a humidifier that is effective yet mold-resistant and easy to clean. It has easily become a part of my nightly ritual to refill my Carepod. Given the health benefits associated with it, I love it so far!", "name": "Dr. Tim Tiutan", "title": "Internal Medicine" } },
        "t2": { "type": "testimonial", "settings": { "avatar_url": "https://hellocarepod.com/cdn/shop/files/Avatar-2.png?v=1730539333&width=240", "quote": "I recently discovered Carepod and absolutely love it. As a pediatric naturopathic doctor, the cold and dry climate we're in makes it a valuable addition. I'm obsessed with everything about it, especially the stainless steel water tank, which is so easy to clean. And the best part? It won't grow mold.", "name": "Dr. Elana Roumell", "title": "Pediatric Naturopathic" } },
        "t3": { "type": "testimonial", "settings": { "avatar_url": "https://hellocarepod.com/cdn/shop/files/Kate_Zelinski.jpg?v=1733190648&width=240", "quote": "How often do we talk about sleep when it comes to kids? All the time. They need good sleep to function. Our old humidifier was hard to clean and always got moldy. When I saw that Carepod only had three pieces that needed cleaning (and was easy!), I immediately knew that this was the one.", "name": "Katie Zelinski", "title": "Pediatric Occupational Therapist" } },
        "t4": { "type": "testimonial", "settings": { "avatar_url": "https://hellocarepod.com/cdn/shop/files/Tess_Zolly_caabb8ce-b958-4917-8ab1-af212ef7aa05.jpg?v=1733190726&width=240", "quote": "Carepod is hands down the best humidifier on the market. It's sleek, fun to use, soothing, and holds a good amount of water so you can benefit from it day or night. I highly recommend it to all my clients for their skin, and overall wellness!", "name": "Tess Zolly", "title": "Licensed Esthetician" } },
        "t5": { "type": "testimonial", "settings": { "avatar_url": "https://hellocarepod.com/cdn/shop/files/Dr._Jesse_Berry.jpg?v=1733190801&width=240", "quote": "Once one of my daughters starts coughing, it keeps on going, so we use humidifiers all the time. I love how easy it is to clean our Carepod, with three easy steps. It feels good knowing I'm giving my child the most hydrating air only!", "name": "Dr. Jesse L. Berry", "title": "Ophthalmology Surgeon" } },
        "t6": { "type": "testimonial", "settings": { "avatar_url": "https://hellocarepod.com/cdn/shop/files/Dr._Jiyeh_Yoo.jpg?v=1733190844&width=240", "quote": "I recommend Carepod for anyone thanks to its health benefits, and especially because it's so convenient and easy to clean. As a bonus, I love its modern chic design that blends well into any environment.", "name": "Dr. Jiyeh Joo", "title": "Family Physician" } }
