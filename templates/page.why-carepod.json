    "customer_reviews": {
      "type": "cp-customer-reviews",
      "blocks": {
        "r1": { "type": "review", "settings": { "name": "Dawn M.", "text": "This humidifier is absolutely amazing. I have tried so many humidifiers over the years and they all get moldy so quickly. The stainless steel tank is genius — I can actually see that it's clean!", "rating": 5, "verified": true } },
        "r2": { "type": "review", "settings": { "name": "Laura S.", "text": "Best purchase I've made for my family's health. My kids sleep so much better with the Carepod running. The fact that I can boil the parts for sterilization gives me real peace of mind.", "rating": 5, "verified": true } },
        "r3": { "type": "review", "settings": { "name": "Alizabeth C.", "text": "I was skeptical about spending more on a humidifier, but the Carepod is worth every penny. No more scrubbing hidden crevices. Three parts, easy clean, done. My sinuses have never been happier.", "rating": 5, "verified": true } },
        "r4": { "type": "review", "settings": { "name": "Mary Z.", "text": "We have the Cube Plus in our bedroom and the Mini in the nursery. Both are whisper-quiet and the warm mist on the Cube Plus is wonderful during winter. Highly recommend!", "rating": 5, "verified": true } },
        "r5": { "type": "review", "settings": { "name": "Diana K.", "text": "Finally a humidifier that doesn't make me worry about what my family is breathing. The stainless steel design is beautiful and functional. Cleaning takes less than a minute!", "rating": 5, "verified": true } },
        "r6": { "type": "review", "settings": { "name": "Lindsay T.", "text": "Bought this after my allergist recommended a humidifier that was truly easy to clean. The Carepod exceeded all expectations. It's sleek, quiet, and I can actually sterilize it properly.", "rating": 5, "verified": true } }
